{
  "name": "relib",
  "productName": "re.lib",
  "version": "1.0.0",
  "description": "re.lib – Konstrukteur-Bibliothek (Formeln, Einheiten, Kältetechnik, Berechnungen)",
  "author": "re engineering solution GmbH",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "onl.resolution.relib",
    "productName": "re.lib",
    "copyright": "re engineering solution GmbH",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "www/**/*"],
    "win": { "target": "nsis", "icon": "build/icon.ico", "artifactName": "reLib-Setup-${version}.${ext}" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "re.lib"
    },
    "publish": [{ "provider": "github", "owner": "__OWNER__", "repo": "__REPO__", "releaseType": "release" }]
  }
}
